# Claude (recomendado). Sem chave, o builder roda em modo "motor offline" com a biblioteca curada.
ANTHROPIC_API_KEY=
# Modelo e esforço (opcional)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# GitHub (opcional — aumenta o limite de buscas do Reference Engine)
GITHUB_TOKEN=

# Chromium para o scraper do Behance (opcional). Sem ele, usa fetch + biblioteca curada.
CHROME_PATH=

# Onde salvar os projetos. Padrão: ./data/projects (na Vercel, use /tmp/projects)
DATA_DIR=

# Código de acesso para proteger o builder (opcional). Se definido, a tela pede o código.
BUILDER_ACCESS_CODE=

# Armazenamento durável (recomendado em produção/Vercel): Supabase Storage.
# Crie um bucket PRIVADO com o nome abaixo. Sem isso, os projetos ficam em disco (DATA_DIR).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=builder-projects
